# Zmienne środowiskowe serwera HERO. Skopiuj do hero.env i uzupełnij.
# Serwer nie ma zależności z npm i nie czyta żadnego pliku .env sam — te zmienne
# podaje się przez hosting, docker compose (`env_file`) albo systemd (`EnvironmentFile`).

# Plik bazy SQLite. Musi leżeć na dysku, który przeżyje restart kontenera.
HERO_DB=/data/hero.sqlite

# Port, na którym nasłuchuje serwer. Hostingi PaaS zwykle narzucają swój — patrz deploy/README.md.
PORT=8080

# TLS bezpośrednio w serwerze. Zostaw puste, jeśli certyfikatem zajmuje się hosting
# albo reverse proxy (tak jest w każdej konfiguracji z tego katalogu poza samodzielnym serwerem).
# HERO_TLS_KEY=/certs/key.pem
# HERO_TLS_CERT=/certs/cert.pem
